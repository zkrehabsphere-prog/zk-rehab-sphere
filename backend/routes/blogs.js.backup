const express = require('express');
const BlogPost = require('../models/BlogPost');
const { protect } = require('../middleware/auth');
const { requireRole } = require('../middleware/roles');
const { uploadBlogImage, uploadToCloudinary } = require('../middleware/upload');

const router = express.Router();

function buildBlogFilter(query, isAdmin = false) {
  const filter = {};

  if (!isAdmin) {
    filter.status = { $in: ['published', 'scheduled'] };
    filter.publishedAt = { $lte: new Date() };
  }

  if (query.search) {
    const regex = new RegExp(query.search, 'i');
    filter.$or = [
      { title: regex },
      { summary: regex },
      { 'author.name': regex },
      { tags: regex },
      { category: regex },
      { 'seoTitle': regex },
    ];
  }

  if (query.category) {
    filter.category = query.category;
  }

  if (query.status) {
    filter.status = query.status;
  }

  return filter;
}

/**
 * GET /api/blogs
 * Public: Get all published blog posts with optional search and category filters
 */
router.get('/', async (req, res, next) => {
  try {
    const page = parseInt(req.query.page, 10) || 1;
    const limit = parseInt(req.query.limit, 10) || 12;
    const filter = buildBlogFilter(req.query);

    const [blogs, total] = await Promise.all([
      BlogPost.find(filter)
        .sort({ publishedAt: -1 })
        .skip((page - 1) * limit)
        .limit(limit),
      BlogPost.countDocuments(filter),
    ]);

    res.json({
      success: true,
      blogs,
      pagination: {
        page,
        limit,
        total,
        pages: Math.ceil(total / limit),
      },
    });
  } catch (err) {
    next(err);
  }
});

/**
 * GET /api/blogs/all
 * Admin: Get all blog posts (including drafts and scheduled)
 */
router.get('/all', protect, requireRole('admin'), async (req, res, next) => {
  try {
    const page = parseInt(req.query.page, 10) || 1;
    const limit = parseInt(req.query.limit, 10) || 15;
    const filter = buildBlogFilter(req.query, true);

    const [blogs, total] = await Promise.all([
      BlogPost.find(filter)
        .sort({ createdAt: -1 })
        .skip((page - 1) * limit)
        .limit(limit),
      BlogPost.countDocuments(filter),
    ]);

    res.json({
      success: true,
      blogs,
      pagination: {
        page,
        limit,
        total,
        pages: Math.ceil(total / limit),
      },
    });
  } catch (err) {
    next(err);
  }
});

/**
 * GET /api/blogs/:slug
 * Public: Get single blog post by slug
 */
router.get('/:slug', async (req, res, next) => {
  try {
    const blog = await BlogPost.findOne({ slug: req.params.slug });
    if (!blog) return res.status(404).json({ error: 'Blog post not found.' });

    const isVisible = blog.status !== 'draft' && new Date(blog.publishedAt) <= new Date();
    if (!isVisible) {
      return res.status(404).json({ error: 'Blog post not yet available.' });
    }

    blog.views += 1;
    await blog.save();

    res.json({ success: true, blog });
  } catch (err) {
    next(err);
  }
});

/**
 * POST /api/blogs
 * Admin: Create a new blog post with image uploads
 */
router.post('/', protect, requireRole('admin'), uploadBlogImage.fields([
  { name: 'coverImage', maxCount: 1 },
  { name: 'gallery', maxCount: 10 },
]), async (req, res, next) => {
  try {
    let coverImageUrl = req.body.coverImage;
    let galleryUrls = req.body.gallery || [];

    // Upload cover image to Cloudinary if provided
    if (req.files?.coverImage?.[0]) {
      try {
        const result = await uploadToCloudinary(
          req.files.coverImage[0].buffer,
          'zk-rehab-blogs/covers',
          `blog-cover-${Date.now()}`
        );
        coverImageUrl = result.secure_url;
      } catch (err) {
        console.error('Cover image upload failed:', err);
        return res.status(400).json({ error: 'Failed to upload cover image' });
      }
    }

    // Upload gallery images to Cloudinary if provided
    if (req.files?.gallery?.length > 0) {
      try {
        const uploadPromises = req.files.gallery.map((file, index) =>
          uploadToCloudinary(
            file.buffer,
            'zk-rehab-blogs/gallery',
            `blog-gallery-${Date.now()}-${index}`
          )
        );
        const results = await Promise.all(uploadPromises);
        galleryUrls = results.map(r => r.secure_url);
      } catch (err) {
        console.error('Gallery upload failed:', err);
        return res.status(400).json({ error: 'Failed to upload gallery images' });
      }
    }

    const blog = await BlogPost.create({
      ...req.body,
      coverImage: coverImageUrl,
      gallery: galleryUrls,
      publishedAt: req.body.publishedAt || Date.now(),
    });

    res.status(201).json({ success: true, blog });
  } catch (err) {
    next(err);
  }
});

/**
 * PUT /api/blogs/:id
 * Admin: Update a blog post with image uploads
 */
router.put('/:id', protect, requireRole('admin'), uploadBlogImage.fields([
  { name: 'coverImage', maxCount: 1 },
  { name: 'gallery', maxCount: 10 },
]), async (req, res, next) => {
  try {
    const blog = await BlogPost.findById(req.params.id);
    if (!blog) return res.status(404).json({ error: 'Blog post not found.' });

    let updateData = { ...req.body };

    // Upload new cover image to Cloudinary if provided
    if (req.files?.coverImage?.[0]) {
      try {
        const result = await uploadToCloudinary(
          req.files.coverImage[0].buffer,
          'zk-rehab-blogs/covers',
          `blog-cover-${Date.now()}`
        );
        updateData.coverImage = result.secure_url;
      } catch (err) {
        console.error('Cover image upload failed:', err);
        return res.status(400).json({ error: 'Failed to upload cover image' });
      }
    }

    // Upload new gallery images to Cloudinary if provided
    if (req.files?.gallery?.length > 0) {
      try {
        const uploadPromises = req.files.gallery.map((file, index) =>
          uploadToCloudinary(
            file.buffer,
            'zk-rehab-blogs/gallery',
            `blog-gallery-${Date.now()}-${index}`
          )
        );
        const results = await Promise.all(uploadPromises);
        const galleryUrls = results.map(r => r.secure_url);
        // Append new images to existing gallery
        updateData.gallery = [...(blog.gallery || []), ...galleryUrls];
      } catch (err) {
        console.error('Gallery upload failed:', err);
        return res.status(400).json({ error: 'Failed to upload gallery images' });
      }
    }

    const updatedBlog = await BlogPost.findByIdAndUpdate(
      req.params.id,
      updateData,
      { new: true, runValidators: true }
    );

    res.json({ success: true, blog: updatedBlog });
  } catch (err) {
    next(err);
  }
});

/**
 * DELETE /api/blogs/:id
 * Admin: Delete a blog post
 */
router.delete('/:id', protect, requireRole('admin'), async (req, res, next) => {
  try {
    const blog = await BlogPost.findByIdAndDelete(req.params.id);
    if (!blog) return res.status(404).json({ error: 'Blog post not found.' });
    res.json({ success: true, message: 'Blog post deleted.' });
  } catch (err) {
    next(err);
  }
});

/**
 * POST /api/blogs/:id/like
 * Public: Increment likes counter
 */
router.post('/:id/like', async (req, res, next) => {
  try {
    const blog = await BlogPost.findByIdAndUpdate(req.params.id, { $inc: { likes: 1 } }, { new: true });
    if (!blog) return res.status(404).json({ error: 'Blog post not found.' });
    res.json({ success: true, likes: blog.likes });
  } catch (err) {
    next(err);
  }
});

/**
 * POST /api/blogs/:id/share
 * Public: Increment shares counter
 */
router.post('/:id/share', async (req, res, next) => {
  try {
    const blog = await BlogPost.findByIdAndUpdate(req.params.id, { $inc: { shares: 1 } }, { new: true });
    if (!blog) return res.status(404).json({ error: 'Blog post not found.' });
    res.json({ success: true, shares: blog.shares });
  } catch (err) {
    next(err);
  }
});

module.exports = router;
